# Wazuh Security Lab - local configuration
# Copy this file to `.env` before starting (lab.sh up does it automatically).
#
# SECURITY NOTE: these are *training* credentials for a lab that binds only to
# 127.0.0.1 and never exposes the Wazuh components to the network. The
# INDEXER_PASSWORD must match the hash baked into the wazuh-indexer image
# (internal_users.yml); if you change it, follow the official Wazuh password
# management procedure. See README.md.

# Pinned Wazuh version, used for all official images and the agent package.
WAZUH_VERSION=4.14.10

# Local port for the Wazuh dashboard (https://localhost:<port>).
DASHBOARD_PORT=8443

# Indexer admin credentials (default of the official Wazuh Docker images).
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword

# Wazuh API credentials (default of the official Wazuh Docker images).
# NOTE: wazuh/dashboard/wazuh.yml also contains this password; if you change
# API_PASSWORD, update that file as well.
API_USER=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# CPU platform for the official Wazuh images (leave empty = native).
# Apple Silicon note: some official arm64 Wazuh image builds contain binaries
# compiled for Graviton-class CPUs (SVE) that Apple Silicon does not
# implement - the wazuh-manager then crashes with "Illegal instruction"
# (create_user.py). In that case set:
#WAZUH_PLATFORM=linux/amd64
# and enable "Use Rosetta for x86_64/amd64 emulation on Apple silicon" in
# Docker Desktop (Settings > General). Rosetta runs the whole lab smoothly.
